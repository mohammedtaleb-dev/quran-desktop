{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "القرآن الكريم",
  "mainBinaryName": "QuranKareem",
  "version": "1.2.0",
  "identifier": "com.qurankareem.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "القرآن الكريم",
        "width": 1200,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "maximized": true,
        "backgroundColor": "#2b2b2b",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,MediaRouter,AutofillServerCommunication --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-pings"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; frame-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/pages/**",
          "$RESOURCE/docs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "pages/*",
      "docs/*"
    ],
    "publisher": "القرآن الكريم",
    "shortDescription": "القرآن الكريم — المصحف الشامي بدون إنترنت",
    "windows": {
      "nsis": {
        "languages": [
          "Arabic"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
